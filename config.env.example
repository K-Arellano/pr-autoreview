# Copy to config.env and edit. config.env is gitignored.

# Only review PRs in these orgs/users (space-separated). Empty = every repo.
# Strongly recommended: limits auto-approval to repos you trust.
OWNERS=""

# owner/repo entries to skip (space-separated).
EXCLUDE_REPOS=""

# Approve automatically when Claude finds no issues. false = always COMMENT.
AUTO_APPROVE=true

# Cap reviews per run so a big queue doesn't burn your usage limits in one go.
MAX_PRS_PER_RUN=5

# Stop retrying a PR head after this many failures.
MAX_ATTEMPTS=3

# Claude model alias or id. Empty = Claude Code's default.
MODEL=""

# How often launchd runs the reviewer, in seconds (read by install.sh).
INTERVAL_SECONDS=900

# 1 = print the review payload instead of posting it.
DRY_RUN=0
